<?xml version="1.0" encoding="UTF-8"?>
<FTL>

<mod:findName type="event" name="THE_JUDGES_ZOLTAN">
	<mod-append:choice hidden="true" req="LIST_CREW_OE_ACID" blue="false">
		<text>Present an Acidic Crewmember.</text>
		<event>
			<text>"The Acidic Growth's finest constructs, valiantly protecting itself... and now you as well. Wary of outsiders, it is nothing short of... impressive you managed to recruit one to your cause. Yes, I am... impressed. Expect... rewards before your next journey."</text>
			<metaVariable name="prof_z_boon_oe_acid" op="set" val="1" />
			<achievement silent="false">ACH_BOON_OE_ACID</achievement>
			<choice hidden="true">
				<text>Continue...</text>
				<event load="THE_JUDGES_ZOLTAN_ADVICE" />
			</choice>
		</event>
	</mod-append:choice>
</mod:findName>

<mod:findName type="event" name="THE_JUDGES_VARIABLE_CLEAR">
    <mod-append:metaVariable name="prof_z_boon_oe_acid" op="set" val="0" />
</mod:findName>

</FTL> 

<FTL>
<!--ACIDIC DESTROYER B-->
<ship name="SHIP_OET_BOSS_ACID_NORMAL" auto_blueprint="OET_BOSS_ACID_NORMAL">
	<destroyed load="OET_BOSS_ACID_DESTROYED" />
	<deadCrew load="OET_BOSS_ACID_DEADCREW" />
</ship>
<ship name="SHIP_OET_BOSS_ACID_CHALLENGE" auto_blueprint="OET_BOSS_ACID_CHALLENGE">
	<destroyed load="OET_BOSS_ACID_DESTROYED" />
	<deadCrew load="OET_BOSS_ACID_DEADCREW" />
</ship>
<ship name="SHIP_OET_BOSS_ACID_EXTREME" auto_blueprint="OET_BOSS_ACID_EXTREME">
	<destroyed load="OET_BOSS_ACID_DESTROYED" />
	<deadCrew load="OET_BOSS_ACID_DEADCREW" />
</ship>
<ship name="SHIP_OET_BOSS_ACID_CHAOS" auto_blueprint="OET_BOSS_ACID_CHAOS">
	<destroyed load="OET_BOSS_ACID_DESTROYED" />
	<deadCrew load="OET_BOSS_ACID_DEADCREW" />
</ship>
<mod:findName type="event" name="MV_TRAVELER_GENERIC_NORMAL">
    <mod:findLike type="loadEventList">
        <mod-append:event name="MV_TRAVELER_OET_BOSS_ACID_NORMAL"/>
    </mod:findLike>
</mod:findName>
<mod:findName type="event" name="MV_TRAVELER_GENERIC_CHALLENGE">
    <mod:findLike type="loadEventList">
        <mod-append:event name="MV_TRAVELER_OET_BOSS_ACID_CHALLENGE"/>
    </mod:findLike>
</mod:findName>
<mod:findName type="event" name="MV_TRAVELER_GENERIC_EXTREME">
    <mod:findLike type="loadEventList">
        <mod-append:event name="MV_TRAVELER_OET_BOSS_ACID_EXTREME"/>
    </mod:findLike>
</mod:findName>
<mod:findName type="event" name="MV_TRAVELER_GENERIC_CHAOS">
    <mod:findLike type="loadEventList">
        <mod-append:event name="MV_TRAVELER_OET_BOSS_ACID_CHAOS"/>
    </mod:findLike>
</mod:findName>
<event name="MV_TRAVELER_OET_BOSS_ACID_NORMAL">
	<text id="renegade_discover_oe_acid"/>
	<ship load="SHIP_OET_BOSS_ACID_NORMAL" hostile="false" /> 
	<choice hidden="true">
		<text>Prepare to fight!</text>
		<event>
			<text id="renegade_intro_oe_acid"/>
			<ship hostile="true" /> 
			<choice hidden="true">
				<text>Continue...</text>
				<event load="COMBAT_CHECK" />
			</choice>
		</event>
	</choice>
	<choice>
		<text id="renegade_tribute_scrap" />
		<event>
			<text id="renegade_tributed" />
			<item_modify>
				<item type="scrap" min="-35" max="-35" />
			</item_modify>
		</event>
	</choice>
	<choice hidden="true" req="JUDGE_BOON_RENEGADE">
		<text>Use your blessing to avoid combat.</text>
		<event load="MV_TRAVELER_BOON" />
	</choice>
</event>
<event name="MV_TRAVELER_OET_BOSS_ACID_CHALLENGE">
	<beaconType id="map_icon_quest" global="true">
		<color r="25" g="205" b="150" a="1.0" />
		<unvisitedTooltip>This is the location of abnormal energy signatures. [Acidic B]</unvisitedTooltip>
		<visitedTooltip>Explored location. Nothing left of interest.</visitedTooltip>
	</beaconType>
	<text id="renegade_discover_oe_acid"/>
	<ship load="SHIP_OET_BOSS_ACID_CHALLENGE" hostile="false" /> 
	<choice hidden="true">
		<text>Prepare to fight!</text>
		<event>
			<text id="renegade_intro_oe_acid"/>
			<ship hostile="true" /> 
			<choice hidden="true">
				<text>Continue...</text>
				<event load="COMBAT_CHECK" />
			</choice>
		</event>
	</choice>
	<choice>
		<text id="renegade_tribute_scrap" />
		<event>
			<text id="renegade_tributed" />
			<item_modify>
				<item type="scrap" min="-40" max="-40" />
			</item_modify>
		</event>
	</choice>
	<choice hidden="true" req="JUDGE_BOON_RENEGADE">
		<text>Use your blessing to avoid combat.</text>
		<event load="MV_TRAVELER_BOON" />
	</choice>
</event>
<event name="MV_TRAVELER_OET_BOSS_ACID_EXTREME">
	<text id="renegade_discover_oe_acid"/>
	<ship load="SHIP_OET_BOSS_ACID_EXTREME" hostile="false" /> 
	<choice hidden="true" max_group="0">
		<text>Prepare to fight!</text>
		<event>
			<text id="renegade_intro_oe_acid"/>
			<ship hostile="true" /> 
			<choice hidden="true">
				<text>Continue...</text>
				<event load="COMBAT_CHECK" />
			</choice>
		</event>
	</choice>
	<choice blue="false" req="loc_sector_count" lvl="0" max_lvl="4">
		<text id="renegade_tribute_scrap" />
		<event>
			<text id="renegade_tributed" />
			<item_modify>
				<item type="scrap" min="-45" max="-45" />
			</item_modify>
		</event>
	</choice>
	<choice hidden="true" req="loc_sector_count" lvl="5">
		<text id="renegade_tribute_scrap_impossible" />
		<event load="OPTION_INVALID" />
	</choice>
	<choice hidden="true" req="JUDGE_BOON_RENEGADE">
		<text>Use your blessing to avoid combat.</text>
		<event load="MV_TRAVELER_BOON" />
	</choice>
</event>
<event name="MV_TRAVELER_OET_BOSS_ACID_CHAOS">
	<text id="renegade_discover_oe_acid"/>
	<ship load="SHIP_OET_BOSS_ACID_CHAOS" hostile="false" /> 
	<eventAlias jumpClear="false" name="OET_BOSS_ACID_DROP">OET_BOSS_ACID_DROP_CHAOS</eventAlias>
	<choice hidden="true">
		<text>Continue...</text>
		<event>
			<text id="renegade_intro_oe_acid"/>
			<ship hostile="true" /> 
			<choice hidden="true">
				<text>Continue...</text>
				<event load="COMBAT_CHECK" />
			</choice>
		</event>
	</choice>
	<choice blue="false" req="BRIBE_CHAOS" lvl="1">
		<text id="renegade_tribute_scrap" />
		<event>
			<text id="renegade_tributed_chaos" />
			<playSound>gm_bribe</playSound>
			<variable name="gnome_bribe" op="set" val="1" />
			<item_modify>
				<item type="scrap" min="-45" max="-45" />
			</item_modify>
		</event>
	</choice>
	<choice hidden="true" blue="false" req="BRIBE_CHAOS" lvl="0" max_lvl="0">
		<text>*%$##@*%!</text>
		<event load="OPTION_INVALID" />
	</choice>
	<choice hidden="true" req="JUDGE_BOON_RENEGADE">
		<text>Use your blessing to avoid combat.</text>
		<event load="MV_TRAVELER_BOON" />
	</choice>
</event>

<event name="OET_BOSS_ACID_DESTROYED">
	<text id="renegade_destroyed" />
	<autoReward level="HIGH">standard_no_item</autoReward>
	<variable name="ach_ren_oe_acid" op="set" val="1" />
	<metaVariable name="prof_renegades_killed" op="add" val="1" />
	<choice hidden="true">
		<text>Continue...</text>
		<event load="OET_BOSS_ACID_DROP_CHANCE" />
	</choice>
</event>
<eventList name="OET_BOSS_ACID_DROP_CHANCE">
	<event>
		<text id="renegade_drop_fail" />
		<autoReward level="LOW">stuff</autoReward>
	</event>
	<event><loadEvent>OET_BOSS_ACID_DROP</loadEvent></event>
</eventList>

<event name="OET_BOSS_ACID_DEADCREW">
	<text id="renegade_killed" />
	<autoReward level="HIGH">standard_no_item</autoReward>
	<variable name="ach_ren_oe_acid" op="set" val="1" />
	<metaVariable name="prof_renegades_killed" op="add" val="1" />
	<choice hidden="true">
		<text>Continue...</text>
		<event><loadEvent>OET_BOSS_ACID_DROP</loadEvent></event>
	</choice>
</event>

<event name="OET_BOSS_ACID_DROP">
	<text id="renegade_drop_yes" />
	<achievement silent="false">ACH_OE_REN_ACID</achievement>
	<autoReward level="LOW">stuff</autoReward>
	<weapon name="OE_LASER_ACID_BOSS" />
</event>
<event name="OET_BOSS_ACID_DROP_CHAOS">
	<text id="renegade_drop_yes" />
	<achievement silent="false">ACH_OE_REN_ACID</achievement>
	<autoReward level="LOW">stuff</autoReward>
	<weapon name="OE_LASER_ACID_BOSS_CHAOS" />
</event>
</FTL>