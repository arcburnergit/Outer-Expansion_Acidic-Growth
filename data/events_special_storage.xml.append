<?xml version="1.0" encoding="UTF-8"?>
<FTL>
<mod:findName type="event" name="STORAGE_CHECK_BUTTON">
  <mod-append:choice req="OE_ACID_O2SYS" blue="true" hidden="true">
    <text>Acidic Filtering System.</text>
    <event load="STORAGE_CHECK_OE_O2SYS" />
  </mod-append:choice>
  <mod-append:choice req="OE_ACID_O2SYS_OFF" blue="true" hidden="true">
    <text>Acidic Filtering System.</text>
    <event load="STORAGE_CHECK_OE_O2SYS_OFF" />
  </mod-append:choice>
</mod:findName>

<event name="STORAGE_CHECK_OE_O2SYS">
	<text>What do you want to do?</text>
	<checkCargo />
	<choice>
		<text>Nevermind.</text>
		<event load="STORAGE_CHECK" />
	</choice>

  <choice hidden="true">
    <text>Set Filtering System to Extinguisher Mode (Currently Enabled).</text>
    <event load="OPTION_INVALID"/>
  </choice>

  <choice>
    <text>Set Filtering System to Oxygen Mode.</text>
    <event>
      <text>Your Filtering system shifts over to begin producing oxygen.</text>
      <remove name="OE_ACID_O2SYS"/>
      <choice>
        <text>Continue...</text>
        <event>
          <text>The system's lifesupport subsystem slows down.</text>
          <augment name="OE_ACID_O2SYS_OFF"/>
          <choice>
            <text>Continue...</text>
            <event load="STORAGE_CHECK" />
          </choice>
        </event>
      </choice>
    </event>
  </choice>
</event>


<event name="STORAGE_CHECK_OE_O2SYS_OFF">
  <text>What do you want to do?</text>
  <checkCargo />
	<choice>
		<text>Nevermind.</text>
		<event load="STORAGE_CHECK" />
	</choice>

  <choice>
    <text>Set Filtering System to Extinguisher Mode.</text>
    <event>
      <text>Your Filtering system shifts over to begin producing fire suppressant.</text>
      <remove name="OE_ACID_O2SYS_OFF"/>
      <choice>
        <text>Continue...</text>
        <event>
          <text>The system's lifesupport subsystem becomes more efficient.</text>
          <augment name="OE_ACID_O2SYS"/>
          <choice>
            <text>Continue...</text>
            <event load="STORAGE_CHECK" />
          </choice>
        </event>
      </choice>
    </event>
  </choice>

  <choice hidden="true">
    <text>Set Filtering System to Oxygen Mode (Currently Enabled).</text>
    <event load="OPTION_INVALID"/>
  </choice>
</event>

<mod:findName name="STORAGE_CHECK_AUG_OE_BOSS_SPAWNER_LIST" type="event">
  <mod-append:choice hidden="true">
		<text>Acidic Destroyer B - Drops Acid Splasher</text>
		<event>
			<text>You power up the machine to max and watch as a rift opens, shaking the ship until suddenly it powers off, and a flashing green light followed by a string of coordinates signifies that it has worked.</text>
			<item_modify>
				<item type="fuel" min="-7" max="-7" />
			</item_modify>
			<quest event="MV_TRAVELER_OET_BOSS_ACID_CHALLENGE" />
		</event>
	</mod-append:choice>
</mod:findName>

<mod:findName name="STORAGE_CHECK_STATUS_LOOT">
	<mod-append:choice hidden="true" req="ach_trans_oe_acid" lvl="1" blue="false">
		<text>(Acidic Origins)</text>
		<event load="OPTION_INVALID"/>
	</mod-append:choice>
</mod:findName>

<mod:findName name="STORAGE_CHECK_STATUS_MV">
	<mod-append:choice hidden="true" req="ach_ren_oe_acid" lvl="1" blue="false">
		<text>Acidic Destroyer</text>
		<event>
			<text>CLASS: Acidic Destroyer
			FACTION: Acidic Growth
			
			TODO: this text
			</text>
			<choice>
				<text>Continue...</text>
				<event load="STORAGE_CHECK_STATUS"/>
			</choice>
		</event>
	</mod-append:choice>
</mod:findName>

<mod:findName name="STORAGE_CHECK_STATUS_CREW">
	<mod-append:choice hidden="true" req="ach_crew_oe_bill" lvl="1" blue="false">
		<text>Bill</text>
		<event>
			<text>PROFILE: Bill
			Title: Acidic Castaway
			Species: Acidic Growth - Age: Unknown - Gender: N/A
			
			TODO: this text
			</text>
			<choice>
				<text>Continue...</text>
				<event load="STORAGE_CHECK_STATUS"/>
			</choice>
		</event>
	</mod-append:choice>
</mod:findName>


<mod:findName name="STORAGE_CHECK_CREW_REAL">
	<mod-append:choice req="unique_oe_bill" blue="false" hidden="true">
		<text>Look for Bill.</text>
		<event load="SOCIALIZE_OE_BILL_LIST"/>
	</mod-append:choice>
</mod:findName>
</FTL>