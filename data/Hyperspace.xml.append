<FTL>
<mod:findLike type="scripts" limit="1" reverse="false">
  <mod-append:script>data/oe_scripts/core_acid.lua</mod-append:script>
  <mod-append:script>data/oe_scripts/acid_effect.lua</mod-append:script>
  <mod-append:script>data/oe_scripts/acid_nebula.lua</mod-append:script>
</mod:findLike>

<mod:findLike type="ships" limit="1" reverse="false">
	<mod:findLike type="shipIcons">
		<mod-append:shipIcon>
            <name>icon_oe_acidic_filter</name>
            <tooltip>ACIDIC FILTERING SYSTEM:
The oxygen system on this ship will heal all crew onboard and extinguishes fires, however it won't provide oxygen.</tooltip>
		</mod-append:shipIcon>
		<mod-append:shipIcon>
            <name>icon_oe_acidic_filter_weak</name>
            <tooltip>WEAK ACIDIC FILTERING SYSTEM:
The oxygen system will provide a slow healing effect to all crew.</tooltip>
		</mod-append:shipIcon>
	</mod:findLike>
	<mod:findLike type="shipOrder">
		<mod:setAttributes oe_has_half="false"/>
	</mod:findLike>
	<mod:findWithChildLike type="shipOrder" child-type="empty">
		<mod:selector oe="true"/>
		<mod:setAttributes oe_has_half="true"/>
	</mod:findWithChildLike>
	<mod:findLike type="shipOrder">
		<mod:selector oe_has_half="true"/>
		<mod:findLike type="empty">
			<mod:selector oe="true"/>
			<mod:removeTag/>
		</mod:findLike>
		<mod-append:ship>PLAYER_SHIP_OE_ACID_CREW1</mod-append:ship>
		<mod-append:empty/>
		<mod-append:ship>PLAYER_SHIP_OE_ACID_ARTY</mod-append:ship>
		<mod-append:ship>PLAYER_SHIP_OE_ACID_LONG</mod-append:ship>
		
		<mod-append:empty/>
		<mod-append:empty/>
		<mod:removeAttributes oe_has_half="" />
	</mod:findLike>
	<mod:findLike type="shipOrder">
		<mod:selector oe_has_half="false"/>
		<mod-append:ship>PLAYER_SHIP_OE_ACID_ARTY</mod-append:ship>
		<mod-append:ship>PLAYER_SHIP_OE_ACID_LONG</mod-append:ship>
		<mod-append:empty/>
		<mod-append:ship>PLAYER_SHIP_OE_ACID_CREW1</mod-append:ship>
		
		<mod-append:empty oe="true"/>
		<mod-append:empty oe="true"/>
		<mod-append:empty oe="true"/>
		<mod-append:empty oe="true"/>

		<mod-append:empty oe="true"/>
		<mod-append:empty oe="true"/>
		<mod:removeAttributes oe_has_half="" />
	</mod:findLike>
	<mod-append:ship name="PLAYER_SHIP_OE_ACID_ARTY" b="true" c="true" >
		<unlock variant="a" silent="false">
			<type>4</type>
		</unlock>
		<unlock variant="b" silent="false">
            <type>1</type>
            <shipReq>PLAYER_SHIP_OE_ACID_ARTY</shipReq>
            <value>5</value>
        </unlock>
		<unlock variant="c" silent="false">
            <type>1</type>
            <shipReq>PLAYER_SHIP_OE_ACID_ARTY_2</shipReq>
            <value>5</value>
        </unlock>
		<unlock variant="c" silent="false">
            <type>2</type>
            <shipReq>PLAYER_SHIP_OE_ACID_ARTY</shipReq>
        </unlock>
	</mod-append:ship>
	<mod-append:ship name="PLAYER_SHIP_OE_ACID_LONG" b="true" c="true" >
		<unlock variant="a" silent="false">
			<type>4</type>
		</unlock>
		<unlock variant="b" silent="false">
            <type>1</type>
            <shipReq>PLAYER_SHIP_OE_ACID_LONG</shipReq>
            <value>5</value>
        </unlock>
		<unlock variant="c" silent="false">
            <type>1</type>
            <shipReq>PLAYER_SHIP_OE_ACID_LONG_2</shipReq>
            <value>5</value>
        </unlock>
		<unlock variant="c" silent="false">
            <type>2</type>
            <shipReq>PLAYER_SHIP_OE_ACID_LONG</shipReq>
        </unlock>
	</mod-append:ship>
	<mod-append:ship name="PLAYER_SHIP_OE_ACID_CREW1" b="false" c="false" secret="true">
		<unlock variant="a" silent="false">
			<type>4</type>
		</unlock>
	</mod-append:ship>

	<mod-append:customShip name="PLAYER_SHIP_OE_ACID_ARTY">
