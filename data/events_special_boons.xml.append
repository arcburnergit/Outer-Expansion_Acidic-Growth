<?xml version="1.0" encoding="UTF-8"?>
<FTL>	
<event name="BOON_SELECT_OE_ACID">
	<text>From nowhere, you hear a voice speaking to you. "The Boon... of Growth. Your Acidic crew will... heal twice as fast. You may... thank the previous challenger. Or maybe you... do not? Who can say..."</text>
	<hiddenAug>BOON_CREW_OE_ACID</hiddenAug>
	<choice hidden="true">
		<text>Continue...</text>
		<event>
			<loadEvent>BOON_SELECT_CONTINUE</loadEvent>
		</event>
	</choice>
</event>
</FTL>
