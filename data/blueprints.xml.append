<!--Artillery-->
<FTL>

<weaponBlueprint name="OE_ARTILLERY_BEAM_ACID_1">
	<type>BEAM</type>
	<flavorType>Acid Beam</flavorType>
	<title>'Hasta' Beam</title>
	<short>'Hasta'</short>
	<tip>tip_beams</tip>
	<desc>Designed by the acidic growth, this weapon continues to degrade the enemy system after impact.</desc>
	<tooltip>.</tooltip>
	<damage>0</damage>
	<sp>0</sp>
	<fireChance>0</fireChance>
	<breachChance>0</breachChance>
	<erosionChance>10</erosionChance>
	<erosion>
		<speed>0.5</speed>
		<maxSpeed>0.75</maxSpeed>
		<time>15.0</time>
		<maxTime>30.0</maxTime>
		<systemRepairMultiplier>1</systemRepairMultiplier>
