<?xml version="1.0" encoding="UTF-8"?>
<!--SECTOR COLOURS AND SPAWNING-->
<FTL>
<!-- SPAWNING -->
<mod:findName type="sectorType" name="ZONE_SAFE">
</mod:findName>

<mod:findName type="sectorType" name="SECTOR_LIST_ALLIED">
</mod:findName>
<mod:findName type="sectorType" name="SECTOR_LIST_NEUTRAL">
    <mod-append:sector>SECTOR_OE_ACID_NEBULA</mod-append:sector>
</mod:findName>
<mod:findName type="sectorType" name="SECTOR_LIST_HOSTILE">
</mod:findName>
<mod:findName type="sectorType" name="SECTOR_LIST_GENERIC">
</mod:findName>

<mod:findName type="sectorType" name="SECTOR_LIST_UNIQUE_SAFE">
</mod:findName>
<mod:findName type="sectorType" name="SECTOR_LIST_UNIQUE_DEADLY">
    <mod-append:sector>SECTOR_OE_ACID_UNIQUE</mod-append:sector>
</mod:findName>

<!-- COLOURS -->
<mod:findName type="sectorType" name="CIVILIAN">
</mod:findName>
<mod:findName type="sectorType" name="NEUTRAL">
</mod:findName>
<mod:findName type="sectorType" name="HOSTILE">
</mod:findName>
<mod:findName type="sectorType" name="NEBULA">
    <mod-append:sector>SECTOR_OE_ACID_NEBULA</mod-append:sector>
    <mod-append:sector>SECTOR_OE_ACID_UNIQUE</mod-append:sector>
</mod:findName>

<mod:findName type="sectorType" name="SECRET">
</mod:findName>

<!--SECTORS-->

<sectorDescription name="SECTOR_OE_ACID_NEBULA" unique="false">
	<nameList>
		<name>Acidic Expansion</name>
		<name>Acidic Colonies</name>
		<name>Acidic Space</name>
		<name>Acidic Frontier</name>
		<name>Acidic Territory</name>
		<name>Acidic Rimworlds</name>
		<name>Acidic Regions</name>
		<name>Acidic Parts</name>
		<name>Acidic Dominion</name>
		<name>Acidic Turf</name>
		<name>Acidic Realm</name>
		<name>Acidic Quarter</name>
		<name>Acidic Outreaches</name>
		<name>Acidic Outreaches</name>
	</nameList>
	<trackList>
		<track>oe_acidic</track>
		<track>debris</track>
		<track>deepspace</track>
	</trackList>
	<rarityList>
		<blueprint name="human" rarity="5" />
		<blueprint name="human_medic" rarity="0" />
		<blueprint name="human_engineer" rarity="0" />
		<blueprint name="engi" rarity="0" />
		<blueprint name="engi_separatist" rarity="0" />
		<blueprint name="zoltan" rarity="0" />
		<blueprint name="zoltan_monk" rarity="0" />
		<blueprint name="zoltan_devotee" rarity="0" />
		<blueprint name="rock" rarity="4" />
		<blueprint name="rock_outcast" rarity="0" />
		<blueprint name="rock_commando" rarity="0" />
		<blueprint name="mantis" rarity="4" />
		<blueprint name="mantis_free" rarity="0" />
		<blueprint name="orchid" rarity="1" />
		<blueprint name="orchid_caretaker" rarity="3" />
		<blueprint name="shell" rarity="5" />
		<blueprint name="shell_scientist" rarity="0" />
		<blueprint name="shell_mechanic" rarity="0" />
		<blueprint name="shell_guardian" rarity="5" />
		<blueprint name="crystal" rarity="0" />
		<blueprint name="crystal_liberator" rarity="0" />
		<blueprint name="leech" rarity="3" />
		<blueprint name="lanius" rarity="0" />
		<blueprint name="phantom" rarity="0" />
		<blueprint name="phantom_goul" rarity="0" />
		<blueprint name="phantom_mare" rarity="0" />
		<blueprint name="phantom_wraith" rarity="0" />

        <blueprint name="OE_LASER_ACID_1" rarity="3" />
        <blueprint name="OE_LASER_ACID_2" rarity="2" />
        <blueprint name="OE_LASER_ACID_3" rarity="3" />
        <blueprint name="OE_BEAM_ACID_1" rarity="3" />
        <blueprint name="OE_ION_ACID_1" rarity="2" />
		
        <blueprint name="OE_LASER_ACID_1_ELITE" rarity="5" />
        <blueprint name="OE_LASER_ACID_2_ELITE" rarity="5" />
        <blueprint name="OE_ION_ACID_1_ELITE" rarity="5" />
	</rarityList>
	<startEvent>ENTER_OE_ACID</startEvent>
	<removeFirstBeaconNebula />
	<nebulaSector>true</nebulaSector>
	<exitBeacon event="FINISH_BEACON_OE_ACID" nebulaEvent="FINISH_BEACON_NEBULA" rebelEvent="FINISH_BEACON_FLEET_ELITE" />
	<rebelBeacon event="FLEET_THREAT_LOW" nebulaEvent="FLEET_THREAT_LOW_NEBULA" />
	<priorityEvent name="ANOMALY_SPAWNER" min="1" max="1" priority="1" req="ANOMALY_SPAWN_CHECK" lvl="1" />
	<event name="NEBULA_SYLVAN_CHANCE" min="0" max="1" />

	<priorityEvent name="NEBULA_LIGHT_DISTRESS_REROUTE_ACIDIC" min="0" max="1" priority="1" />
	
	<event name="NEBULA_STORELIST_OE_ACID" min="2" max="2" />
	<priorityEvent name="STORELIST_OE_ACID" min="0" max="1" priority="0" />
	
	<event name="NEBULA_ITEMS_OE_ACID" min="2" max="4" />
	<event name="NEBULA_NEUTRAL_OE_ACID" min="3" max="5" />
	<event name="NEBULA_DISTRESS_OE_ACID" min="1" max="2" />
	<event name="NEBULA_QUEST_OE_ACID" min="1" max="1" />
	<priorityEvent name="CLEARING_OE_ACID" min="1" max="4" priority="0" />
	
	<event name="NEBULA_HOSTILE_OE_ACID" min="3" max="6" />
	
	<event name="PIRACY_LIST" min="1" max="2" />
	<event name="FILLER_LIST" min="999" max="999" />
</sectorDescription>


