<mod:findLike type="crew" limit="1" reverse="false">
	<mod-append:race name="oe_acid_worker">
		<resistsMindControl>true</resistsMindControl>
		<maxHealth>100</maxHealth>
		<canSuffocate>false</canSuffocate>
		<damageMultiplier>0.75</damageMultiplier>
		<repairSpeed>1.5</repairSpeed>
		<moveSpeedMultiplier>1.5</moveSpeedMultiplier>
		<deathSounds>
			<deathSound>sysExplosion</deathSound>
		</deathSounds>
		<powerEffect name="power_oe_acid_worker">
			<cooldown>30</cooldown>
			<jumpCooldown>full</jumpCooldown>
			<powerSounds>
				<powerSound>cultivatorSpore</powerSound>
			</powerSounds>
			<req type="enemy">
				<inCombat/>
				<extraConditions type="or" textId="power_not_ready_teleporting_or_stunned">
					<repairingSystem>true</repairingSystem>
					<fighting>true</fighting> 
					<sabotaging>true</sabotaging>
				</extraConditions>
			</req>
			<buttonText>GAS</buttonText>
			<tooltip>[COOLDOWN:30s]
Release Acidic Gas into the current room, which lasts 10 seconds.
- Gas causes a hull breach every 5 seconds.
- Gas Damages connected doors, causing them to break open temporarily.
			</tooltip>
			<cooldownColor r="50" g="166" b="31"/>
			<activateWhenReady enemiesOnly="true">true</activateWhenReady>
		</powerEffect>
	</mod-append:race>
	<mod-append:race name="oe_acid_soldier">
		<resistsMindControl>true</resistsMindControl>
		<maxHealth>150</maxHealth>
		<canSuffocate>false</canSuffocate>
		<damageMultiplier>1.25</damageMultiplier>
		<repairSpeed>1</repairSpeed>
		<deathSounds>
			<deathSound>sysExplosion</deathSound>
		</deathSounds>
		<powerEffect name="power_oe_acid_soldier">
			<cooldown>20</cooldown>
			<jumpCooldown>full</jumpCooldown>
			<powerSounds>
				<powerSound>cultivatorSpore</powerSound>
			</powerSounds>
			<req type="enemy">
				<inCombat/>
				<extraConditions type="or" textId="power_not_ready_teleporting_or_stunned">
					<repairingSystem>true</repairingSystem>
					<fighting>true</fighting> 
					<sabotaging>true</sabotaging>
				</extraConditions>
			</req>
			<buttonText>GAS</buttonText>
			<tooltip>[COOLDOWN:20s]
Release Acidic Gas into the current room, which lasts 10 seconds.
- Gas causes a hull breach every 5 seconds.
- Gas Damages connected doors, causing them to break open temporarily.
			</tooltip>
			<cooldownColor r="50" g="166" b="31"/>
			<activateWhenReady enemiesOnly="true">true</activateWhenReady>
		</powerEffect>
	</mod-append:race>
	<mod-append:race name="unique_oe_bill">
		<resistsMindControl>true</resistsMindControl>
		<maxHealth>150</maxHealth>
		<canSuffocate>false</canSuffocate>
		<damageMultiplier>1.5</damageMultiplier>
		<repairSpeed>1.5</repairSpeed>
		<deathSounds>
			<deathSound>sysExplosion</deathSound>
		</deathSounds>
		<powerEffect name="power_unique_oe_bill">
			<cooldown>20</cooldown>
			<jumpCooldown>full</jumpCooldown>
			<powerSounds>
				<powerSound>cultivatorSpore</powerSound>
			</powerSounds>
			<req type="enemy">
				<inCombat/>
				<extraConditions type="or" textId="power_not_ready_teleporting_or_stunned">
					<repairingSystem>true</repairingSystem>
					<fighting>true</fighting> 
					<sabotaging>true</sabotaging>
				</extraConditions>
			</req>
			<buttonText>GAS</buttonText>
			<tooltip>[COOLDOWN:20s]
Release a unique form of Acidic Gas into the current room, which lasts 10 seconds.
- Gas heals all allies for 4.8hp/s.
- Gas increases combat damage and repair speed of all allies by 1.5x.
			</tooltip>
			<cooldownColor r="50" g="166" b="31"/>
			<activateWhenReady enemiesOnly="true">true</activateWhenReady>
			<roomStatBoosts>
				<statBoost name="healAmount">
					<boostType>FLAT</boostType>
					<amount>4.8</amount>
					<shipTarget>ALL</shipTarget>
					<crewTarget>ALLIES</crewTarget>
					<affectsSelf>true</affectsSelf>
					<droneTarget>CREW</droneTarget>
                    <duration>10</duration>
					<jumpClear>true</jumpClear>
					<maxStacks>1</maxStacks>
					<priority>10000</priority>
					<blackList>
						<human_technician_drone/>
						<zoltan_osmian_hologram/>
						<repair/> <!--TRC-->
					</blackList>
					<roomAnim renderLayer="2">                                                    
						<anim animType="default" animBorder="2">oe_invisible</anim>                                                 
							<tileAnim>unique_oe_bill_tile_anim</tileAnim>  
					</roomAnim>
				</statBoost>
				<statBoost name="damageMultiplier">
					<boostType>MULT</boostType>
					<amount>1.5</amount>
					<shipTarget>ALL</shipTarget>
					<crewTarget>ALLIES</crewTarget>
					<affectsSelf>true</affectsSelf>
					<droneTarget>CREW</droneTarget>
                    <duration>10</duration>
					<jumpClear>true</jumpClear>
					<maxStacks>1</maxStacks>
					<priority>10000</priority>
					<blackList>
						<human_technician_drone/>
						<zoltan_osmian_hologram/>
						<repair/>
					</blackList>
				</statBoost>
				<statBoost name="repairSpeed">
					<boostType>MULT</boostType>
					<amount>1.5</amount>
					<shipTarget>ALL</shipTarget>
					<crewTarget>ALLIES</crewTarget>
					<affectsSelf>true</affectsSelf>
					<droneTarget>CREW</droneTarget>
                    <duration>10</duration>
					<jumpClear>true</jumpClear>
					<maxStacks>1</maxStacks>
					<priority>10000</priority>
					<blackList>
						<human_technician_drone/>
						<zoltan_osmian_hologram/>
						<repair/>
					</blackList>
				</statBoost>
			</roomStatBoosts>
		</powerEffect>
	</mod-append:race>
</mod:findLike>

<mod:findLike type="augments" limit="1" reverse="false">
	<mod-append:aug name="BOON_CREW_OE_ACID">
    	<statBoosts>
			<statBoost name="healSpeed">
				<boostType>SET</boostType>
				<amount>2</amount>
				<shipTarget>ALL</shipTarget>
				<crewTarget>ALLIES</crewTarget>
				<droneTarget>CREW</droneTarget>
				<priority>99999</priority>
				<whiteList load="LIST_CREW_OE_ACID" />
			</statBoost>
		</statBoosts>
	</mod-append:aug>
	<mod-append:aug name="LAB_OE_ACID_REPAIR">
    	<statBoosts>
			<statBoost name="passiveHealAmount">
				<boostType>FLAT</boostType>
				<amount>6.4</amount>
				<shipTarget>ALL</shipTarget>
				<crewTarget>ALLIES</crewTarget>
				<priority>999</priority>
				<whiteList load="LIST_CREW_OE_ACID" />
			</statBoost>
			<statBoost name="passiveHealDelay">
				<boostType>SET</boostType>
				<amount>5</amount>
				<shipTarget>ALL</shipTarget>
				<crewTarget>ALLIES</crewTarget>
				<priority>999</priority>
				<whiteList load="LIST_CREW_OE_ACID" />
			</statBoost>
		</statBoosts>
	</mod-append:aug>
	<mod-append:aug name="LAB_OE_ACID_SENSOR">
    	<statBoosts>
			<statBoost name="stunMultiplier">
				<boostType>SET</boostType>
				<amount>0</amount>
				<shipTarget>ALL</shipTarget>
				<crewTarget>ALLIES</crewTarget>
				<priority>9999</priority>
				<whiteList load="LIST_CREW_OE_ACID" />
			</statBoost>
		</statBoosts>
	</mod-append:aug>
	<mod-append:aug name="LAB_OE_ACID_COOLING">
    	<statBoosts>
			<statBoost name="rangedDamageMultiplier">
				<boostType>MULT</boostType>
				<amount>2</amount>
				<shipTarget>ALL</shipTarget>
				<crewTarget>ALLIES</crewTarget>
				<priority>999</priority>
				<whiteList load="LIST_CREW_OE_ACID" />
			</statBoost>
			<statBoost name="maxHealth">
				<boostType>MULT</boostType>
				<amount>0.5</amount>
				<shipTarget>ALL</shipTarget>
				<crewTarget>ALLIES</crewTarget>
				<priority>999</priority>
				<whiteList load="LIST_CREW_OE_ACID" />
			</statBoost>
		</statBoosts>
	</mod-append:aug>
    <mod-append:aug name="OE_ACID_O2SYS">
		<statBoosts>
			<statBoost name="healAmount">
				<boostType>FLAT</boostType>
				<shipTarget>ORIGINAL_SHIP</shipTarget>
				<crewTarget>ALL</crewTarget>
				<droneTarget>CREW</droneTarget>
				<amount>1.8</amount>
				<priority>0</priority>
				<systemPowerDependency>
					<oxygen />
				</systemPowerDependency>
				<systemPowerScaling>
					<noSys>0</noSys>
					<noPwr>0</noPwr>
					<onePwr>1</onePwr>
					<twoPwr>1.5</twoPwr>
					<threePwr>1.8</threePwr>
					<fourPwr>2</fourPwr>
